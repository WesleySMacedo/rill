{
	"compilerOptions": {
		"target": "ES2023",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["ES2023"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": false
	},
	"include": ["src/**/*.ts"]
}
